# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Optional — only needed for gated Hugging Face models
HF_TOKEN=

# Required — comma-separated list of key:name pairs. Use long random keys.
# Example: API_KEYS=k8f2-xq91-a7c3:Tariq,p3m9-zz41-b2d8:Client One
API_KEYS=change-this-key:Local User

# Optional — any MLX model from Hugging Face
MODEL_NAME=mlx-community/Qwen3-8B-4bit

# Optional — use a different system prompt file (default shown)
# SYSTEM_PROMPT_FILE=prompts/system_prompt.txt

# Optional — how closely a document passage must match to be used;
# lower = stricter (default 0.8). Re-measure after changing the embedding model.
# RAG_MAX_DISTANCE=0.8

# Optional — document chunk size and overlap, in words (defaults shown).
# Each chunk should fit within what the embedding model can read.
# Changes apply to new uploads only: delete chroma_db and upload documents again.
# RAG_CHUNK_WORDS=150
# RAG_CHUNK_OVERLAP=30